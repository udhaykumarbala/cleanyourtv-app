<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="tv.cleanyour.homeinterceptor">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="30" />
    <queries><package android:name="com.gathin.tvhome" /></queries>
    <application android:label="Home Interceptor">
        <service
            android:name=".HomeService"
            android:label="Home Interceptor"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter><action android:name="android.accessibilityservice.AccessibilityService" /></intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/service" />
        </service>
        <activity android:name=".ProbeActivity" android:exported="true" android:theme="@android:style/Theme.DeviceDefault.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
