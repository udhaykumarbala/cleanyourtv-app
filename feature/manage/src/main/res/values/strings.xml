    <!-- Stop and undo ask first (Confirmations): a question, one calm sentence, the verb and a way back -->
    <string name="confirm_stop_title">Stop now?</string>
    <string name="confirm_stop_body">We stop here and put back what we changed so far. Your TV stays safe.</string>
    <string name="confirm_stop_button">Stop and undo</string>
    <string name="confirm_keep_going">Keep going</string>
    <string name="confirm_stop_here_title">Stop here?</string>
    <string name="confirm_stop_here_body">We keep what is already done and change nothing else. Your TV stays safe.</string>
    <string name="confirm_stop_here_button">Stop here</string>
    <string name="confirm_undo_title">Undo the changes on the TV?</string>
    <string name="confirm_undo_body">We put back everything this change did, so the TV is as it was before. Nothing is deleted.</string>
    <string name="confirm_undo_button">Undo the changes</string>

    <!-- 0.3.2 B1: an unlisted TV on Manage -->
    <string name="manage_help_add_tv_banner">We haven\'t met this exact TV before, so we were careful with it. A short report from you helps us add it.</string>
    <string name="manage_help_add_tv">Help add this TV</string>

    <!-- 0.3.2 B1 and B2: the report preview -->
    <string name="report_tv_title">Help add this TV</string>
    <string name="report_tv_body">This report says what this TV is and which apps it came with, so we can make a list for it. Apps you installed yourself are only counted, never named.</string>
    <string name="report_problem_title">Report a problem</string>
    <string name="report_problem_body">This report has the steps we ran and a short summary of the TV, as plain text. Addresses, serial numbers, keys and codes are removed first. The steps can name apps we switched off or tried to.</string>
    <string name="report_public">This is public if you post it on GitHub. The app sends nothing itself: you choose where it goes.</string>
    <string name="report_preview_label">The report</string>
    <string name="report_paste_hint">We copy the report, then open the form on GitHub. Paste it into the box that asks for it.</string>
    <string name="report_copy_open">Copy and open GitHub</string>
    <!-- 0.3.3 D1: the report fits in the link, so the form opens with it filled in -->
    <string name="report_open">Open GitHub</string>
    <string name="report_in_link_hint">The form on GitHub opens with this report already in it. Add a few words if you like, then post it. We copy the report too, in case the form opens without it.</string>
    <string name="report_too_long">This report is too long to go into the form by itself, so we copy it for you. On GitHub, long-press the report box, choose Paste, then post it.</string>
    <string name="report_share">Share</string>
    <string name="report_loading">Making the report</string>
    <string name="report_unavailable">We need to read this TV once before we can make its report. Set it up or connect to it, then try again.</string>
</resources>
