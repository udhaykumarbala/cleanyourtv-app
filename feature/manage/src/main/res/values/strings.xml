    <string name="appsettings_privacy">Privacy</string>
    <string name="appsettings_privacy_text">Nothing leaves your network except downloads from github.com. GitHub sees your phone\'s address and a generic user agent. A report leaves the phone only when you copy, share or post it yourself.</string>
    <string name="appsettings_privacy_text_offline">Nothing leaves your network. The app talks only to the TV you pick and makes no internet requests of its own. A report leaves the phone only when you copy, share or post it yourself.</string>
    <string name="appsettings_report">Report a problem</string>
    <string name="appsettings_report_note">See the report first, then share it or post it on GitHub</string>
    <string name="appsettings_reset_key">Reset my key</string>
    <string name="appsettings_reset_key_note">Every TV will ask to trust this phone again.</string>
    <string name="appsettings_reset_key_title">Reset the key on this phone?</string>
    <string name="appsettings_reset_key_confirm">Reset my key</string>
