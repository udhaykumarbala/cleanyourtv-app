    <!-- M1a Debugging step for a returning write (UX 4.3, returning) -->
    <string name="debugstep_title">To change things on the TV, debugging needs to be on for a moment.</string>
    <string name="debugstep_body">On the TV: Settings > Device Preferences > Developer options > USB debugging. We\'ll take it from there and switch it off again when we\'re done.</string>
    <string name="debugstep_note">You won\'t need to press Build again. Developer options stays unlocked.</string>
    <string name="debugstep_waiting">Waiting for the TV...</string>
    <string name="debugstep_connecting">Connecting...</string>

    <!-- A Manage write that paused and left its run open (R5-W8 O2) -->
    <string name="openwrite_title">A change on {tv} didn\'t finish</string>
    <string name="openwrite_body_lost">The TV stopped answering partway through. Carry on with the rest, or undo what we did. Until then nothing else can change on this TV.</string>
    <string name="openwrite_body">We stopped partway through. Carry on with the rest, or undo what we did. Until then nothing else can change on this TV.</string>
    <string name="openwrite_body_setup">The setup of {tv} didn\'t finish. Open it to carry on or undo what we did.</string>
    <string name="openwrite_not_taken">The TV didn\'t answer. Check that it\'s on and on the same Wi-Fi as this phone, then try again.</string>
    <string name="openwrite_busy">Working on it...</string>
    <string name="openwrite_carry_on">Carry on</string>
    <string name="openwrite_undo">Undo what we did</string>
    <string name="openwrite_stop">Stop here</string>
    <string name="openwrite_open_setup">Open the setup</string>
    <string name="openwrite_later">Not now</string>
    <string name="openwrite_report">Report a problem</string>

