    <string name="switchedoff_empty">Nothing is switched off right now.</string>
    <string name="switchedoff_empty_sub">Everything on the TV is switched on.</string>

    <!-- M5 Check for leftovers -->
    <string name="leftovers_title">Check for leftovers</string>
    <string name="leftovers_checking">Checking...</string>
    <string name="leftovers_found">{count, plural, one {# thing came back after an update. Switch it off again?} other {# things came back after an update. Switch them off again?}}</string>
    <string name="leftovers_switch_off">Switch off</string>
    <string name="leftovers_not_now">Not now</string>
    <string name="leftovers_none">Nothing came back. All as you left it.</string>
